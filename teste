*{
    margin: 0px;
    padding: 0px;
    font-family: Verdana;
};




#col{
    margin: 15px auto;
    padding: 30px 40px;
    box-shadow: 0 10px 50px;
    border-radius: 15px;

    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 30px;

    transition: 0.3s;
}

#col:hover{
    transform: translateY(-3px);
}

.img-col{
    height: 140px;
    object-fit: cover;
    border-radius: 15px;
}

.card-content{
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
}

.butao{
    cursor: pointer;
    background-color: blue;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    border: 2px solid yellow;
    padding: 5px 10px;
    margin-top: 20px;
    font-size: 15px;
    transition: 0.3s;
}

.butao:hover{
    padding: 15px 25px;
}

footer {
    color:#696969;
    text-align: center;
    padding: 10px;
    position: relative;
    bottom: 0;
